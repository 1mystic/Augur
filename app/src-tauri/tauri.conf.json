{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Augur",
  "version": "0.3.0",
  "identifier": "me.atharvk.augur",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Augur",
        "width": 1360,
        "height": 900,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "BoardGame",
    "shortDescription": "Screenshot to chess position + Stockfish top 3",
    "license": "GPL-3.0-or-later"
  }
}